{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crankscore-guide",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "GUIDE_ORIGIN": "https://trostliam-hub.github.io",
    "GUIDE_MONTHLY_REQUESTS": "1000"
  },
  "durable_objects": {
    "bindings": [{ "name": "GUIDE_QUOTA", "class_name": "GuideQuota" }]
  },
  "exports": {
    "GuideQuota": { "type": "durable-object", "storage": "sqlite" }
  }
}
